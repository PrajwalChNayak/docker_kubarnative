# Non-secret configuration for api and worker.
# configMapGenerator turns this into the ConfigMap tasklane-config, with a
# content hash appended to the name so a config change rolls the pods.
PGHOST=postgres
PGPORT=5432
PGUSER=tasklane
PGDATABASE=tasklane
PGSSLMODE=disable
PGPASSWORD_FILE=/etc/tasklane/db/password
SHUTDOWN_DELAY_SECONDS=5
WORK_DURATION_MS=2000
POLL_INTERVAL_MS=1000
