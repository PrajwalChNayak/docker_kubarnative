# syntax=docker/dockerfile:1
# check=error=true

# Same script, but tini is PID 1. tini forwards signals to its child and
# reaps every orphan that the kernel re-parents to it.
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

# `=~0.19` is an apk fuzzy pin: it accepts rebuilds of 0.19.x (0.19.0-r3,
# -r4 ...) but never a different upstream version. An exact `=0.19.0-r3` pin
# is stricter and breaks the build on the next Alpine rebuild.
# hadolint ignore=DL3018
RUN apk add --no-cache 'tini=~0.19'

COPY --chmod=0755 <<'EOF' /app/spawner.sh
#!/bin/sh
trap 'echo "spawner: SIGTERM received, exiting"; exit 0' TERM
echo "spawner: started, my PID is $$"
while :; do
  ( sleep 0.2 & )
  sleep 1 &
  wait $!
done
EOF

USER 65534:65534
# `--` separates tini's own flags from the command it supervises.
ENTRYPOINT ["/sbin/tini", "--", "/app/spawner.sh"]
