{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tasklane chart values",
  "description": "Helm validates values against this schema on lint, template, install and upgrade. Validation runs against the merged values, so a --set typo is rejected before anything reaches the cluster.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api", "worker", "database", "serviceAccount"],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$",
          "description": "Empty, or a sha256 digest. A digest wins over a tag."
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
        "limits": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    }
  },
  "properties": {
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicaCount"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "topologySpreadConstraints": { "type": "array" },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "podDisruptionBudget": { "$ref": "#/definitions/podDisruptionBudget" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicaCount"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "podDisruptionBudget": { "$ref": "#/definitions/podDisruptionBudget" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "existingSecretKey"],
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "user": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sslMode": { "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] },
        "existingSecret": { "type": "string", "minLength": 1 },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "config": {
      "type": "object",
      "description": "Extra ConfigMap entries. Values must be strings: Kubernetes ConfigMap data is string-to-string, so 5 would render as an integer and be rejected.",
      "additionalProperties": { "type": "string" }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$" },
            "storageClassName": { "type": "string" }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string" },
            "sectionName": { "type": "string" }
          }
        },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "pathPrefix": { "type": "string", "pattern": "^/" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "gatewayNamespace": { "type": "string", "minLength": 1 }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 }
      }
    }
  }
}
