# syntax=docker/dockerfile:1
# check=error=true

# Build-secret demo. Nothing here ends up in the image: a secret mount is a
# tmpfs that exists only for the lifetime of one RUN instruction, and the
# layer it produces records the command, not the mounted file.
#
#   export NPM_TOKEN=not-a-real-token
#   printf 'hunter2' > /tmp/api_token
#   docker buildx build -f examples/build/Dockerfile.secret-demo \
#     --secret id=api_token,src=/tmp/api_token \
#     --secret id=NPM_TOKEN \
#     --ssh default \
#     -t tasklane-secret-demo:dev examples/build
#
# `--secret id=NPM_TOKEN` with no src= or env= reads the environment variable
# of the same name. The SSH mount forwards the agent socket, so a private key
# never enters the build at all.

ARG BUILD_IMAGE=golang:1.27-trixie@sha256:433790e515d27dc6003e847e644cc0af956985cf315c1c58a3b73ee2dd305183
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3

FROM ${BUILD_IMAGE} AS build
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /work

# File secret. required=true fails the build when the secret is missing,
# instead of silently producing an unauthenticated artifact.
# The default target path is /run/secrets/<id>.
RUN --mount=type=secret,id=api_token,required=true \
    test -s /run/secrets/api_token \
 && sha256sum /run/secrets/api_token | cut -c1-16 > /work/token.fingerprint

# Environment secret. env= exposes the value as a variable for tools that
# only read the environment (npm, pip, cargo). It is still not in the layer.
RUN --mount=type=secret,id=NPM_TOKEN,env=NPM_TOKEN,required=true \
    printf 'token length: %s\n' "${#NPM_TOKEN}" > /work/token.length

# SSH mount. The agent socket is bound at $SSH_AUTH_SOCK for this RUN only.
# required is false here so the demo still builds without an agent.
RUN --mount=type=ssh \
    if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then ssh-add -l > /work/ssh.keys || true; fi; \
    touch /work/ssh.keys

# Proof that the secrets are gone: this stage is what gets exported. The
# image has no shell, so read the evidence with the local exporter instead:
#   docker buildx build -f examples/build/Dockerfile.secret-demo \
#     --secret id=api_token,src=/tmp/api_token --secret id=NPM_TOKEN \
#     --output type=local,dest=./out examples/build
# ./out/proof then holds the fingerprint and the length, never the secret.
FROM ${RUNTIME_IMAGE} AS demo
COPY --from=build /work/token.fingerprint /work/token.length /work/ssh.keys /proof/
USER 65532:65532
